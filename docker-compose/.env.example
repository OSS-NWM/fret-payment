# ─────────────────────────────────────────────
# fret-payment production environment
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ───── Container timezone ─────
TZ=Africa/Casablanca

# ───── Database (hosted on remote server) ─────
DB_HOST=your.db.host.or.ip
DB_PORT=5434
DB_NAME=fretpaymentdb
DB_USER=postgres
DB_PASSWORD=change-me

# ───── Keycloak ─────
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/nwm
KEYCLOAK_JWKS=https://keycloak.example.com/realms/nwm/protocol/openid-connect/certs

# ───── CMI Fatourati ─────
FATOURATI_AUTH_URL=https://auth-dev.cmi.co.ma
FATOURATI_BASE_URL=https://agg-merchant-qa.cmi.co.ma
FATOURATI_API_VERSION=v1
FATOURATI_CLIENT_ID=Client_NadorWestmed
FATOURATI_CLIENT_SECRET=change-me
FATOURATI_MERCHANT_CODE=100024
FATOURATI_STORE=100030
FATOURATI_STORE_API_KEY=change-me
FATOURATI_CASHIER_ID=001
FATOURATI_CALLBACK_URL=https://your.public.domain/api/payment/fatourati/callback
FATOURATI_CALLBACK_SECRET=change-me
FATOURATI_TOKEN_TTL=60
